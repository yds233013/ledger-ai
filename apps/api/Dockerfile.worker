# Ledger AI RQ worker — production image.
#
# Same base as the API so OCR behaves identically, and kept as its own file so
# the worker can be split onto its own service without a rewrite. In the
# Railway deployment the two run side by side to share a storage volume.

FROM ledgerai-api:latest AS runtime

USER root
# rq's CLI needs a writable HOME for its own bookkeeping.
RUN mkdir -p /home/ledgerai && chown ledgerai:ledgerai /home/ledgerai
USER ledgerai

ENV RQ_QUEUE=ledgerai \
    HOME=/home/ledgerai

# A worker has no port, so liveness is "can it still reach Redis".
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
  CMD python -c "import os,redis,sys; redis.Redis.from_url(os.environ['REDIS_URL']).ping()" || exit 1

# SIGTERM triggers RQ's warm shutdown: the job in flight finishes before the
# process exits, so a deploy never abandons a half-parsed receipt.
CMD ["sh", "-c", "exec rq worker ${RQ_QUEUE} --url \"${REDIS_URL}\""]
