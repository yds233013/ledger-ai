# Frontend environment. Copy to .env.local. Placeholders only.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match AUTH_SECRET in the repo-root .env — the API verifies tokens
# minted here with the same secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Optional GitHub OAuth. Leave BOTH blank to run without it — the sign-in page
# then shows the demo button and the credentials form only.
# Callback URL to register with GitHub:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
