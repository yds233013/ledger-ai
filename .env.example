# ---------------------------------------------------------------------------
# Ledger AI — example environment. Copy to .env and fill in.
# PLACEHOLDERS ONLY. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Postgres (Compose binds host port 5433; native PG14 already owns 5432) ---
POSTGRES_USER=ledgerai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ledgerai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://ledgerai:change-me-locally@localhost:5433/ledgerai

# --- Redis (RQ broker + analysis cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Shared HS256 secret. Next.js mints the token, FastAPI verifies it.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
ACCESS_TOKEN_TTL_MINUTES=15

# --- Local development demo user (created by scripts/seed_synthetic.py) ---
# This is the PERMANENT account you sign into locally with a password. It is
# unrelated to the ephemeral per-visitor demo accounts the "Try the demo"
# button provisions, which have no password and expire after 24 hours.
DEMO_USER_EMAIL=demo@ledgerai.local
DEMO_USER_PASSWORD=demo-password-change-me

# --- Optional GitHub OAuth (apps/web) ---
# Leave BOTH blank to run without it: the sign-in page then shows only the
# demo button and the credentials form, and nothing about the app degrades.
# Create an OAuth app at https://github.com/settings/developers and set the
# Authorization callback URL to:
#   local        http://localhost:3000/api/auth/callback/github
#   production   https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Object storage (MinIO locally, S3-compatible in production) ---
STORAGE_BACKEND=minio          # minio | local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ledgerai
S3_SECRET_KEY=change-me-locally
S3_BUCKET=ledgerai-uploads
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=.localstorage

# --- AI (optional; the app is fully functional without any key) ---
# Leave AI_ENABLED=false / key blank to run the deterministic engine only.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
# "development" | "production". Production tightens startup checks, silences
# request access logging, and makes public rate limits fail CLOSED.
ENVIRONMENT=development
ENABLE_ACCESS_LOG=true
ANALYSIS_CACHE_TTL_SECONDS=3600

# --- Reverse proxy trust ---
# Rate limits identify callers by IP address. Behind a proxy the socket peer is
# the proxy, so X-Forwarded-For has to be consulted — but ONLY when the request
# actually came from a proxy we run. Both settings are required: the flag alone
# does nothing, because trusting the header whenever it is present is exactly
# the bypass this guards against.
#
# Leave these unset when the API is reached directly (local development, and
# the docker-compose stack). Set BOTH when a load balancer or the Next.js
# service sits in front, listing the proxy addresses or CIDRs.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
