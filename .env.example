# ---------------------------------------------------------------------------
# Ledger AI — example environment. Copy to .env and fill in.
# PLACEHOLDERS ONLY. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Postgres (Compose binds host port 5433; native PG14 already owns 5432) ---
POSTGRES_USER=ledgerai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ledgerai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://ledgerai:change-me-locally@localhost:5433/ledgerai

# --- Redis (RQ broker + analysis cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Shared HS256 secret. Next.js mints the token, FastAPI verifies it.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
ACCESS_TOKEN_TTL_MINUTES=15

# --- Local development demo user (created by scripts/seed_synthetic.py) ---
# This is the PERMANENT account you sign into locally with a password. It is
# unrelated to the ephemeral per-visitor demo accounts the "Try the demo"
# button provisions, which have no password and expire after 24 hours.
DEMO_USER_EMAIL=demo@ledgerai.local
DEMO_USER_PASSWORD=demo-password-change-me

# --- Optional GitHub OAuth (apps/web) ---
# Leave BOTH blank to run without it: the sign-in page then shows only the
# demo button and the credentials form, and nothing about the app degrades.
# Create an OAuth app at https://github.com/settings/developers and set the
# Authorization callback URL to:
#   local        http://localhost:3000/api/auth/callback/github
#   production   https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
# "minio" selects the S3-compatible adapter and is the correct value for R2
# too — the name is the local service, not the protocol. "local" writes to a
# directory and is a single-machine fallback only.
STORAGE_BACKEND=minio          # minio | local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ledgerai
S3_SECRET_KEY=change-me-locally
S3_BUCKET=ledgerai-uploads
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=.localstorage

# Production (Cloudflare R2). Same four variables, different values — the
# adapter is unchanged. Placeholders only; the real values are set on the
# hosting platform and never live in a file.
#
#   STORAGE_BACKEND=minio
#   S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=ledgerai-uploads
#   S3_REGION=auto             # R2 accepts only "auto"
#   S3_ACCESS_KEY=<R2 access key id>
#   S3_SECRET_KEY=<R2 secret access key>
#
# The API and the worker are separate containers with separate filesystems, so
# object storage is not optional in production: it is the only way both can see
# the same receipt. STORAGE_BACKEND=local there means OCR reads a file the API
# wrote to a different disk. The app refuses to fall back to local storage when
# ENVIRONMENT=production for exactly that reason.
#
# Create the bucket before first deploy. Auto-creation runs only outside
# production, because a bucket-scoped R2 token has no CreateBucket permission.

# --- Private beta: Clerk (managed authentication) ---
# OFF by default, and this is the rollback position: with CLERK_ENABLED=false
# the API rejects every RS256 token and the 24-hour demo flow is unaffected.
# Enabled-but-unconfigured resolves to CLOSED, not to accept-anything.
CLERK_ENABLED=false
# Clerk Frontend API URL. Also the `iss` claim. The JWKS URL is DERIVED from
# this and is never configured separately — two variables could drift, and a
# JWKS fetched from anywhere but the issuer is the whole attack.
CLERK_ISSUER=
# The exact web origin permitted to have obtained a token. Required whenever
# Clerk is on: Clerk's docs say skipping the azp check opens the app to CSRF.
CLERK_AUTHORIZED_PARTIES=
# Optional. Clerk session tokens carry no `aud` by default; set this only if a
# custom JWT template adds one, and it then becomes mandatory.
CLERK_AUDIENCE=
# Set in the hosting dashboard, never here. Used to verify the Svix signature
# on Clerk webhooks, over the raw request body.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Private beta gating ---
# Persistent accounts require a matching local invitation, independent of
# Clerk's own invite-only mode.
BETA_INVITE_ONLY=true
# Bumping a version re-prompts everyone; earlier acceptances are retained.
TERMS_VERSION=2026-08-draft-1
PRIVACY_VERSION=2026-08-draft-1
UPLOAD_CONSENT_VERSION=2026-08-draft-1

# --- AI (optional; the app is fully functional without any key) ---
# Leave AI_ENABLED=false / key blank to run the deterministic engine only.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
# "development" | "production". Production tightens startup checks, silences
# request access logging, and makes public rate limits fail CLOSED.
ENVIRONMENT=development
ENABLE_ACCESS_LOG=true
ANALYSIS_CACHE_TTL_SECONDS=3600

# --- Reverse proxy trust ---
# Rate limits identify callers by IP address. Behind a proxy the socket peer is
# the proxy, so X-Forwarded-For has to be consulted — but ONLY when the request
# actually came from a proxy we run. Both settings are required: the flag alone
# does nothing, because trusting the header whenever it is present is exactly
# the bypass this guards against.
#
# Leave these unset when the API is reached directly (local development, and
# the docker-compose stack). Set BOTH when a load balancer or the Next.js
# service sits in front, listing the proxy addresses or CIDRs.
#
# DO NOT COPY A CIDR FROM A BLOG POST OR A FORUM ANSWER. Railway publishes no
# authoritative range for its inbound edge, and a wrong value here does not
# fail loudly — it silently keeps the limits keyed on the proxy, which is the
# thing you were trying to fix. Deploy with these unset, then read the address
# out of the deployment's own logs: the API logs it once, as
#
#   "Rate limits are keyed by the socket peer <address>, but requests carry an
#    X-Forwarded-For chain of N hop(s) ..."
#
# and that observed address is the value to put in TRUSTED_PROXY_IPS.
# See docs/deployment.md, "Proxy trust", for the full procedure and for what
# to do if the address is not stable across deploys.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
